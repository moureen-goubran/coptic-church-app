// Cloudflare Workers hosting: serves the built app (dist/) as static files.
// _headers in public/ (copied into dist/) sets the security headers.
{
  "name": "coptic-church-app",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
