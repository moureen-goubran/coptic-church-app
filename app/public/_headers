# Cloudflare Pages security headers. Only the services the app needs are allowed:
# its own files, the free OpenStreetMap tiles, the Supabase database, and Cloudflare's bot check.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://tiles.openfreemap.org https://*.supabase.co; worker-src 'self' blob:; child-src blob:; frame-src https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

/sw.js
  Cache-Control: no-cache
/data/*
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable
